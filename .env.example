# --- LLM (optional: without a key the app runs fully offline with the scripted planner) ---
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-5-5
SUBAGENT_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-haiku-4-5
ORCHESTRATOR_EFFORT=medium
MAX_AGENT_STEPS=15
MAX_SUBAGENT_STEPS=8
MAX_REVIEW_COST_USD=1.50
FORCE_MOCK=0

# --- Data & retrieval ---
CORPUS_DIR=data/demo
USE_EMBEDDINGS=1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MAX_DOC_CHARS=40000
AUDIT_PATH=audit/audit_log.jsonl

# --- Observability (optional) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_CONSOLE=0
